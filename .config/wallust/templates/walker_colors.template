/* generated from wallust */
/* Token mapping mirrors the old rofi theme: foreground / background /
   color10 as the accent, so walker inherits the same palette rofi had. */
@define-color window_bg_color {{background}};
@define-color accent_bg_color {{color10}};
@define-color theme_fg_color {{foreground}};
@define-color error_bg_color #ff5555;
@define-color error_fg_color {{background}};
